# Node
node_modules/
dist/
.next/
*.tsbuildinfo

# Frontend source is .ts/.tsx only. Vite resolves .js before .ts, so a stray
# emitted .js would silently shadow its source. tsconfig sets noEmit, this is a
# safety net for anyone running a bare `tsc`.
frontend/src/**/*.js

