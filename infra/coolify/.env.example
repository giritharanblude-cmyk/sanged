# SANGAD environment variables — copy to Coolify environment
# Never commit secrets to git.

APP_ENV=local
ALLOWED_HOSTS=sangad.localhost
COOKIE_SECURE=false

# Database — Coolify generates these
DATABASE_URL=postgresql://sangad:password@sangad-postgres:5432/sangad
REDIS_URL=redis://sangad-redis:6379/0

# App security
SECRET_KEY=generate-a-random-secret
ENCRYPTION_KEY=generate-a-32-byte-hex-key

# SMTP — Hostinger mailbox
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your@domain.com
SMTP_PASSWORD=
SMTP_FROM=SANGAD <your@domain.com>

# Local S3 — SeaweedFS Coolify resource
S3_ENDPOINT_URL=http://sangad-s3:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_FILES=sangad-files
S3_BUCKET_BACKUPS=sangad-backups

# WhatsApp — OpenWA
OPENWA_API_URL=http://openwa:3000
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=

# Extraction
EXTRACTION_PROVIDER=llm
LLM_API_KEY=
LLM_API_URL=