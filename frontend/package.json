{
  "name": "sangad-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript openapi.json --output src/generated/api.ts",
    "build": "npm run generate:api && tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9",
    "@tanstack/react-query": "^5.56",
    "@tanstack/react-table": "^8.20",
    "clsx": "^2.1",
    "lucide-react": "^0.441",
    "openapi-typescript": "^7.4",
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-hook-form": "^7.53",
    "react-router-dom": "7.18.4",
    "recharts": "^2.12",
    "tailwind-merge": "^2.5",
    "zod": "^3.23"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.5",
    "@testing-library/react": "^16.0",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.10",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "jsdom": "^25.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.6",
    "typescript-eslint": "^8.71.2",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
