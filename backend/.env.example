# SANGAD configuration — all values are examples, never commit real secrets
# Copy to .env and fill before running

# App
SANGAD_DEBUG=false
SANGAD_SECRET=change-me-to-a-random-64-char-hex

# Database
DATABASE_URL=postgresql://sangad:sangad@localhost:5432/sangad

# Redis
REDIS_URL=redis://localhost:6379/0

# SMTP (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=admin@sangad.example
SMTP_PASSWORD=change-me
SMTP_FROM=SANGAD <admin@sangad.example>

# Encryption key (AES-GCM, 32-byte hex-encoded)
FIELD_ENCRYPTION_KEY=change-me-to-a-64-char-hex-key

# S3-compatible storage
S3_ENDPOINT=https://s3.example.com
S3_REGION=ap-south-1
S3_BUCKET=sangad-files
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Sentry (optional)
SENTRY_DSN=

# OpenWA gateway (internal)
OPENWA_BASE_URL=http://openwa:3000
OPENWA_API_KEY=change-me
OPENWA_WEBHOOK_SECRET=change-me
