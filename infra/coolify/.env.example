# SANGAD environment variables - copy to Coolify environment
# Never commit secrets to git.

APP_ENV=local
DEBUG=false
ALLOWED_HOSTS=sangad.localhost
COOKIE_SECURE=false

# Database - points at the `postgres` compose service (see ADR-16 deviation note
# in docker-compose.yml: production moves these to Coolify database resources).
POSTGRES_DB=sangad
POSTGRES_USER=sangad
POSTGRES_PASSWORD=generate-a-random-password
APP_DB_USER=sangad_app
APP_DB_PASSWORD=generate-a-distinct-random-password
DATABASE_URL=postgresql+psycopg2://sangad_app:generate-a-distinct-random-password@postgres:5432/sangad
MIGRATION_DATABASE_URL=postgresql+psycopg2://sangad:generate-a-random-password@postgres:5432/sangad

# Queue broker - points at the `redis` compose service.
REDIS_URL=redis://redis:6379/0

# App security
SECRET_KEY=generate-a-random-secret
ENCRYPTION_KEY=generate-a-32-byte-hex-key

# SMTP - Hostinger mailbox
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your@domain.com
SMTP_PASSWORD=
SMTP_FROM=SANGAD <your@domain.com>
SMTP_STARTTLS=true

# Local S3 - SeaweedFS Coolify resource (T-010)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_FILES=sangad-files
S3_BUCKET_BACKUPS=sangad-backups
S3_FORCE_PATH_STYLE=true
STORAGE_BACKEND=s3
STORAGE_PATH=/var/lib/sangad/storage

# WhatsApp - OpenWA (Phase 2, T-212)
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=

# Extraction
EXTRACTION_PROVIDER=llm
LLM_API_KEY=
LLM_API_URL=

# Authentication/session policy
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Bootstrap master account; set a unique password before deployment.
ADMIN_USERNAME=admin
ADMIN_EMAIL=your@domain.com
ADMIN_PASSWORD=generate-a-unique-admin-password