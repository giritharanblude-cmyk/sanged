# Local development only. Copy to .env and replace every REPLACE_* value.
APP_ENV=local
DEBUG=false
ALLOWED_HOSTS=localhost,sangad.localhost,127.0.0.1
COOKIE_SECURE=false

POSTGRES_DB=sangad
POSTGRES_USER=sangad
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
APP_DB_USER=sangad_app
APP_DB_PASSWORD=REPLACE_WITH_APP_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg2://sangad_app:REPLACE_WITH_APP_DATABASE_PASSWORD@postgres:5432/sangad
MIGRATION_DATABASE_URL=postgresql+psycopg2://sangad:REPLACE_WITH_LOCAL_PASSWORD@postgres:5432/sangad
REDIS_URL=redis://redis:6379/0

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@sangad.localhost
ADMIN_PASSWORD=REPLACE_WITH_LOCAL_ADMIN_PASSWORD

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SANGAD <no-reply@sangad.localhost>
SMTP_STARTTLS=false

STORAGE_BACKEND=s3
STORAGE_PATH=/var/lib/sangad/storage
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY=REPLACE_WITH_LOCAL_S3_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_LOCAL_S3_SECRET_KEY
S3_BUCKET_FILES=sangad-files
S3_BUCKET_BACKUPS=sangad-backups
S3_FORCE_PATH_STYLE=true

OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
EXTRACTION_PROVIDER=llm
LLM_API_KEY=
LLM_API_URL=

OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
